# Environment Configuration
# Copy this to .env and fill in your actual values

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dark_gaming

# ==================== DARKPAY (UPI GATEWAY) ====================
DARKPAY_UPI_VPA=yourmerchant@bank
DARKPAY_MERCHANT_NAME=Dark Gaming Store
DARKPAY_WEBHOOK_SECRET=your-webhook-secret-key-here-min-32-chars
DARKPAY_GATEWAY_MODE=live

# ==================== PAYMENT PROVIDERS (Optional) ====================
# Razorpay Integration (if using Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==================== API KEYS ====================
# Currency Conversion API
EXCHANGE_RATE_API_KEY=

# ==================== SITE CONFIGURATION ====================
SITE_URL=http://localhost:8000
SITE_NAME=Dark Gaming Store
ADMIN_EMAIL=admin@darkgaming.example

# ==================== SESSION ====================
SESSION_LIFETIME=3600
SESSION_COOKIE_SECURE=false

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_FILE=/var/log/darkpay.log
